.claude/*.local.md
.claude/.*
.DS_Store
.idea
scope_version_cache.json
.gitignore
user_token_cache.json
tenant_token_cache.json
external-resources/*
.playwright-mcp
.vscode/
node_modules/

# The vite build for the shared config UI is an intermediate: what ships is
# plugins/<name>/dist/config-ui/dist/index.html. Plugin bundles under
# plugins/<name>/dist/ are committed on purpose, because this repository is
# installed as a git marketplace and consumers cannot build it themselves.
plugins/*/ui/dist/

.serena/
*.tsbuildinfo
bun.lock

# Workspace / scratch directories
*-workspace/

# Scraper scripts (development artifacts)
scripts/scrape-*.mjs
scripts/scrape-*.js
scripts/generate-*-refs.py
.env
