{
  "name": "agent-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/ticktick",
    "plugins/postgresql",
    "plugins/mysql",
    "plugins/aliyunlog",
    "plugins/ecommerce-expert"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:claude-layout": "bun run .github/scripts/validate-claude-plugin-layout.ts",
    "validate:codex-layout": "bun run .github/scripts/validate-codex-plugin-layout.ts",
    "validate:marketplace": "bun run .github/scripts/validate-marketplace.ts",
    "validate:versions": "bun run .github/scripts/validate-versions.ts",
    "validate:plugins": "npm run validate:claude-layout && npm run validate:codex-layout && npm run validate:marketplace && npm run validate:versions",
    "convert-to-codex": "npx --yes tsx scripts/convert-claude-plugin-to-codex.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.5",
    "tsx": "^4",
    "typescript": "^5.8",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "playwright": "^1.59.1"
  }
}
