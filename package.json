{
  "name": "agent-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugin/ticktick",
    "plugin/postgresql",
    "plugin/mysql",
    "plugin/aliyunlog",
    "plugin/ecommerce-expert",
