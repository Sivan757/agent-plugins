{
  "name": "@agent-plugins/codearts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Huawei Cloud CodeArts CLI — pipelines, builds, checks, deploys, artifacts, repos, wiki and board",
  "scripts": {
    "build": "bash ../../scripts/build-plugin.sh codearts src/codearts.ts",
    "dev": "tsx src/codearts.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "extract": "tsx scripts/extract-api-catalog.ts"
  },
  "dependencies": {
    "@agent-plugins/config-center": "*",
    "commander": "*"
  }
}
